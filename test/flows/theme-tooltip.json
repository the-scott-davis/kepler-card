{
  "baseUrl": "http://127.0.0.1:4173",
  "serve": {
    "command": "PORT=4173 npm run preview",
    "readyUrl": "http://127.0.0.1:4173/preview/index.html",
    "port": 4173
  },
  "steps": [
    {
      "name": "Open the preview",
      "action": "goto",
      "url": "/preview/index.html"
    },
    {
      "name": "Root is drawn",
      "action": "expectVisible",
      "selector": "kepler-card g.node[data-key=\"router\"]"
    },
    {
      "name": "Reveal finishes",
      "action": "expectHidden",
      "selector": "kepler-card .wrap[data-reveal=\"playing\"]"
    },
    {
      "name": "Turn the theme on",
      "action": "click",
      "selector": "#theme"
    },
    {
      "name": "Theme variables are set on the card",
      "action": "expectVisible",
      "selector": "kepler-card[style*=\"--kepler-background\"]"
    },
    {
      "name": "Hover a device",
      "action": "hover",
      "selector": "kepler-card g.node[data-key=\"nas\"]"
    },
    {
      "name": "Tooltip shows its label",
      "action": "expectText",
      "selector": "kepler-card .tip",
      "text": "NAS"
    }
  ]
}
